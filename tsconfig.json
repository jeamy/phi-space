{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "examples",
    "test",
    "scripts/bootstrap-spaces.ts"
  ],
  "exclude": [
    "src/dashboard/palettes.ts"
  ]
}
