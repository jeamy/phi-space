# Copy to idp/.env (ignored by git) and set every secret. docker compose --env-file .env -p phi-idp up -d
IDP_DB_PASSWORD=
IDP_ADMIN=admin
IDP_ADMIN_PASSWORD=
# IDP_URL=http://localhost:4300          # the public address; the issuer is <IDP_URL>/realms/phi
# IDP_PORT=4300                          # the loopback port Keycloak is published on
# Read by the realm import on the first start only:
# IDP_FILES_ORIGIN=https://localhost:4200
IDP_FILES_SECRET=
# IDP_FORUM_ORIGIN=http://localhost:4100
IDP_FORUM_SECRET=
IDP_DEV_USER_PASSWORD=
