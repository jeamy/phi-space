{
  "name": "phi-spaces-mmo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MMORPG engine on phi-spaces: the world is one space; text first, a PixiJS tile map on top (first world: Leuchtfeuer)",
  "scripts": {
    "build": "next build",
    "typecheck": "tsc",
    "dev": "node --no-warnings --experimental-strip-types server/launch.ts --dev",
    "start": "node --no-warnings --experimental-strip-types server/launch.ts",
    "space": "node --no-warnings --experimental-strip-types server/space-host.ts",
    "world": "node --no-warnings --experimental-strip-types server/world-host.ts",
    "web": "node --no-warnings --experimental-strip-types server/index.ts",
    "world:load": "node --no-warnings --experimental-strip-types server/world-load.ts",
    "test": "node --no-warnings --experimental-strip-types --import ./tests/test-env.ts --test tests/*.test.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "phi-spaces": "file:..",
    "pixi.js": "8.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
