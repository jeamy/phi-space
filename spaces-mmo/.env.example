# spaces-mmo: copy to .env (`cp .env.example .env`). server/env.ts loads it in every process; variables already in the
# environment win (`env VAR=… npm start`, docker `environment:`). .env is not committed. Uncommented lines are the
# values a first start needs; commented lines show the defaults.

# ---- Web ----
PORT=3900
# 127.0.0.1 behind a reverse proxy (nginx); 0.0.0.0 to open it on the LAN
SPACES_MMO_BIND=127.0.0.1

# ---- First admin ----
# One-time token: the first account that registers with it becomes the admin. Set it, register, then remove it.
# SPACES_MMO_SETUP_TOKEN=

# ---- Processes (npm start runs all roles in one go) ----
# SPACES_MMO_ROLES=space,world,npc,model,web   # which roles to start here
# SPACES_MMO_WORLD=leuchtfeuer           # which world to load
# SPACES_MMO_DATA=.local                 # directory of world.sqlite and accounts.sqlite
# SPACES_MMO_MEM=1                       # spaces in memory only (nothing is stored): trying things out
# SPACES_MMO_LISTEN=unix:/tmp/spaces-mmo-world.sock        # where the space process serves the world (or tcp:HOST:PORT)
# SPACES_MMO_ACCOUNTS_LISTEN=unix:/tmp/spaces-mmo-accounts.sock
# SPACES_MMO_SPACE=                      # the other processes reach the world here (default: the LISTEN address)
# SPACES_MMO_ACCOUNTS=
# SPACES_MMO_CALL_TIMEOUT=30000          # ms a call to the space may take
# SPACES_MMO_NPCS=                       # the NPC roles this npc process plays, by npcId with commas (empty: all of the world)
# SPACES_MMO_PUBLIC_URL=                 # where a browser reaches the web when that is not where it listens (only for the log line)

# ---- Limits (the admin's configuration window overrides them, see docs/automaten.md "Einstellungen für Betreiber") ----
# SPACES_MMO_REQ_PER_MIN=120             # API requests and WebSocket connects per client IP and minute
# SPACES_MMO_GUESTS_PER_HOUR=5           # new guests per client IP and hour
# SPACES_MMO_REGISTRATIONS_PER_DAY=20    # new accounts per client IP and day
# SPACES_MMO_CMD_BURST=20                # typed commands an account may send at once (all its pages together; steps have their own pace)
# SPACES_MMO_CMD_PER_SEC=5               # and then per second
# SPACES_MMO_GUEST_TTL_MS=604800000      # a guest account lapses after this long without activity (7 days)
# SPACES_MMO_WEB_SESSION_MS=43200000     # web login (12 h, renewed on use)
# SPACES_MMO_SESSION_LEASE_MS=30000      # a game connection without a sign of life lapses
# SPACES_MMO_PENDING_MS=120000           # a broken registration keeps its name this long
# SPACES_MMO_MSG_LEASE_MS=120000         # how long a message stays (2 min)
# SPACES_MMO_CLEANUP_MS=60000            # how often lapsed guests are looked for
# SPACES_MMO_TXN_MS=15000                # lease of a command's transaction: the work of a dead process returns after this
# SPACES_MMO_CLAIM_RESULT_MS=600000     # how long the space keeps the result of a finished call (10 min; the default of 24 h fills the space with claims within a day: "the generation exceeds maxClaimBytes")
# SPACES_MMO_WORLD_LANES=16             # characters a world worker serves at once (each one's commands in order)
# SPACES_MMO_WORLD_INTENTS=1             # 0: this world worker runs no commands, only the world's dates and sweeps (big; commands run next to the space)
# SPACES_MMO_LOG_BYTES=524288            # change history the space keeps for the web process (every commit pays for its size; a web process further behind reads the world again)
# SPACES_MMO_SPOT_SWEEP_MS=30000         # how often the cells of characters that went offline are cleared
# SPACES_MMO_TIME_SCALE=1                # the starting rate of a NEW world's clock: 1 / value world seconds per second (0.01: a world hour in 36 s,
#                                        for quick trials). An existing world keeps its rate; the operator changes it with `clock rate <n>`

# ---- Diagnosis and development ----
# SPACES_MMO_TRACE=1                     # every ten seconds each process logs its calls to the space, per method
# SPACES_MMO_SLOW_MS=                    # a world worker logs every command answered later than this after it was typed
# SPACES_MMO_DEV_ORIGINS=                # `npm run dev`: further hosts (commas) the Next dev server serves its scripts to (127.0.0.1 always)
# Only for the tests: SPACES_MMO_NO_NEXT=1 (web without pages), SPACES_MMO_LLM_MODULE (a scripted model instead of a real
# one), SPACES_MMO_FAULT_PAUSE=give:4000 (a pause inside a command).

# ---- Model calls (they cost tokens): model NPCs and translating plain language into commands ----
# An admin changes the models and the limits below in the game ("Admin" in the header bar); saved values live in the space
# and win over these lines (docs/automaten.md, "Einstellungen für Betreiber"). SPACES_MMO_LLM stays the opt-in.
# SPACES_MMO_SETTINGS_MS=5000            # how often each process reads the saved settings
# SPACES_MMO_LLM=0                       # 1 = model calls allowed; enable only when live model calls are intended
# SPACES_MMO_DURABLE_NPCS=*              # default: all model NPCs; 0 disables, or list role IDs (ines,fremder)
# SPACES_MMO_DURABLE_STORE=              # default: <DATA or .local>/npc-agents/<world>/<region or world>.sqlite
# SPACES_MMO_LLM_MODEL=haiku             # part of the model id: the newest available match is used (cheap by default)
#   The key comes from the environment (as for the pi CLI) or from the pi CLI login in ~/.pi/agent/auth.json.
# SPACES_MMO_LLM_PER_MIN=20              # model calls per minute, all processes together
# SPACES_MMO_LLM_PER_DAY=500             # model calls per day, all processes together
# SPACES_MMO_TRANSLATE_PER_DAY=200       # translations per account and day (the free rules do not count)
# SPACES_MMO_TRANSLATE_GUEST_PER_DAY=20  # the same for guests
# SPACES_MMO_NPC_MAX=10                  # model NPCs awake at the same time (sleeping ones do not count)
# SPACES_MMO_NPC_BUDGET_DAY=-1           # calls per role and world day for every role; -1: each role's own (budgetDay in the world)
# SPACES_MMO_NPC_ROLE_LEASE_MS=30000     # a role moves to another npc process this long after its process died

# ---- Docker (docker/docker-compose.yml reads these from .env; see docs/betrieb.md) ----
# HOST_BIND=127.0.0.1                    # address the web container publishes PORT on
# SPACES_MMO_SPACE_BIND=127.0.0.1        # nano: address the world and accounts spaces are published on (its internal LAN/NetBird address for big)
# SPACES_MMO_WORLD_PORT=3950             # nano: published port of the world space
# SPACES_MMO_ACCOUNTS_PORT=3951          # nano: published port of the accounts space
# NANO_CPUS=0                            # caps the CPUs of the nano container (0: no cap; docker:local:up uses 2, like the smaller machine)
# NANO_HOST_NAME=nano                    # the host names the system bar below the game shows (SPACES_MMO_HOST_NAME of
# BIG_HOST_NAME=big                      # each container; without Docker: SPACES_MMO_HOST_NAME, else the machine's name)
# SPACES_MMO_DEV_PORT=3920               # docker:dev:up: port of the dev container on 127.0.0.1
# SPACES_MMO_DEV_NPCS=                   # docker:dev:up: the NPC roles that play (empty: all; ines,bo lightens the load)
# PI_AUTH_DIR=~/.pi/agent                # the pi CLI login, mounted read-only into npc and model (big) and the dev container;
#                                        # rootless Docker (big): a copy owned by the container user, docs/betrieb.md
# NODE_IMAGE=node:22-bookworm-slim       # build argument of docker/Dockerfile (not read from .env)

# ---- Planned (phase 6 and later, not read yet) ----
# SPACES_MMO_ASSISTANT_PER_DAY=10        # assistant runs per account and day
# SPACES_MMO_AUTOMATA_MAX=100            # automata running at the same time in the whole world
# SPACES_MMO_NPC_CODE_COOLDOWN_MIN=10    # minutes between two code changes of a model NPC's automaton
# SPACES_MMO_GODS=0                      # gods (model NPCs that build islands, quests, events) allowed; needs SPACES_MMO_LLM=1
# SPACES_MMO_ISLANDS_PER_DAY=1           # new islands per day, all gods together
# SPACES_MMO_ISLANDS_MAX=20              # islands built by gods, in total
# SPACES_MMO_ISLAND_ROOMS_MAX=12         # rooms of one island
# SPACES_MMO_GOD_QUESTS_MAX=10           # quests of gods at the same time
# SPACES_MMO_GOD_DRAFTS_PER_DAY=6        # drafts a god may hand in per day (retries count)
