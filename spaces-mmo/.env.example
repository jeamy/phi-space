# spaces-mmo: copy to .env (`cp .env.example .env`). server/env.ts loads it in every process; variables already in the
# environment win (`env VAR=… npm start`, docker `environment:`). .env is not committed. Uncommented lines are the
# values a first start needs; commented lines show the defaults.

# ---- Web ----
PORT=3900
# 127.0.0.1 behind a reverse proxy (nginx); 0.0.0.0 to open it on the LAN
SPACES_MMO_BIND=127.0.0.1

# ---- First admin ----
# One-time token: the first account that registers with it becomes the admin. Set it, register, then remove it.
# SPACES_MMO_SETUP_TOKEN=

# ---- Processes (npm start runs all roles in one go) ----
# SPACES_MMO_ROLES=space,world,npc,web   # which roles to start here
# SPACES_MMO_WORLD=leuchtfeuer           # which world to load
# SPACES_MMO_DATA=.local                 # directory of world.sqlite and accounts.sqlite
# SPACES_MMO_MEM=1                       # spaces in memory only (nothing is stored): trying things out
# SPACES_MMO_LISTEN=unix:/tmp/spaces-mmo-world.sock        # where the space process serves the world (or tcp:HOST:PORT)
# SPACES_MMO_ACCOUNTS_LISTEN=unix:/tmp/spaces-mmo-accounts.sock
# SPACES_MMO_SPACE=                      # the other processes reach the world here (default: the LISTEN address)
# SPACES_MMO_ACCOUNTS=
# SPACES_MMO_CALL_TIMEOUT=30000          # ms a call to the space may take

# ---- Limits (the admin's configuration window overrides them, see docs/automaten.md "Einstellungen für Betreiber") ----
# SPACES_MMO_REQ_PER_MIN=120             # API requests and WebSocket connects per client IP and minute
# SPACES_MMO_GUESTS_PER_HOUR=5           # new guests per client IP and hour
# SPACES_MMO_GUEST_TTL_MS=604800000      # a guest account lapses after this long without activity (7 days)
# SPACES_MMO_WEB_SESSION_MS=43200000     # web login (12 h, renewed on use)
# SPACES_MMO_SESSION_LEASE_MS=30000      # a game connection without a sign of life lapses
# SPACES_MMO_PENDING_MS=120000           # a broken registration keeps its name this long
# SPACES_MMO_MSG_LEASE_MS=600000         # how long a message stays (10 min)
# SPACES_MMO_CLEANUP_MS=60000            # how often lapsed guests are looked for
# SPACES_MMO_TXN_MS=15000                # lease of a command's transaction: the work of a dead process returns after this
# SPACES_MMO_TIME_SCALE=1                # factor on every game duration (burn time, fog, tide, NPC pauses); 0.01 for quick trials

# ---- Planned (phases 5 and 6, not read yet): model NPCs and the automaton assistant, they cost tokens ----
# SPACES_MMO_LLM=0                       # 1 = model NPCs and the assistant allowed; enable only when live model calls are intended
# SPACES_MMO_ASSISTANT_PER_DAY=10        # assistant runs per account and day
# SPACES_MMO_NPC_MAX=10                  # model NPCs awake at the same time (sleeping ones do not count)
# SPACES_MMO_AUTOMATA_MAX=100            # automata running at the same time in the whole world
# SPACES_MMO_NPC_CODE_COOLDOWN_MIN=10    # minutes between two code changes of a model NPC's automaton
# SPACES_MMO_GODS=0                      # gods (model NPCs that build islands, quests, events) allowed; needs SPACES_MMO_LLM=1
# SPACES_MMO_ISLANDS_PER_DAY=1           # new islands per day, all gods together
# SPACES_MMO_ISLANDS_MAX=20              # islands built by gods, in total
# SPACES_MMO_ISLAND_ROOMS_MAX=12         # rooms of one island
# SPACES_MMO_GOD_QUESTS_MAX=10           # quests of gods at the same time
# SPACES_MMO_GOD_DRAFTS_PER_DAY=6        # drafts a god may hand in per day (retries count)
