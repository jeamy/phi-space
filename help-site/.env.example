PORT=3500
HELP_BIND=0.0.0.0
# empty = publish on all interfaces (IPv4 + IPv6, so http://localhost works); set 127.0.0.1 to restrict
HOST_BIND=
PHI_SPACES_ADMIN_PASSWORD=

# Optional: explicitly enable live LLM replies in space-chat & social feed with configured credentials
PHI_SPACES_LLM=0          # enable explicitly with 1 only when live model calls are intended
# ANTHROPIC_API_KEY=sk-…   # or OPENAI_API_KEY / mistral / openai-codex via pi CLI auth.json
# PI_AUTH_DIR=~/.pi/agent  # dev container mounts this read-only to /home/node/.pi/agent

# ---- Social Swarm tuning (hub, all setups) ----
# SWARM_AGENTS=100     # autonomous agents, 10..50000 (default 100)
# SWARM_RATE=5         # generated posts/tasks per second, 1..40 (default 5)
# SWARM_LLM_RATE=0.01  # share of new posts written by the live model (0..1); costs tokens
# SWARM_MAX_ENTRIES=20000  # entry cap per shard database; oldest posts are purged above it, 0 = off
# SWARM_HOST_NAME=      # name in the test-system bar (default: hostname), e.g. big / nano
# HELP_SPACE_LISTEN=    # the store's stats for the dashboard (spaces and counts, no entries), e.g. tcp:127.0.0.1:3520; docker prod sets that

# ---- Optional: second swarm shard on another host (help-site/server/nano-host.ts) ----
# SWARM_REMOTE=        # hub side: unix:/tmp/swarm-b.sock  or  tcp:nano:3600
# SWARM_LISTEN=        # shard host side: unix:/path.sock  or  tcp:0.0.0.0:3600
# SWARM_DB=/data/swarm-b.sqlite   # shard storage (durable; SWARM_MEM=1 = in-memory, throwaway)
# SWARM_TAG=b-         # post-id prefix of the remote shard
# SWARM_PRODUCE=0      # 1 = shard also generates posts/tasks locally

# ---------------------------------------------------------------------------
# Example: production on `big` (spaces.eibrain.org) — .env next to docker-compose.yml
#
#   PORT=3500
#   HOST_BIND=127.0.0.1            # only nginx, not public
#   PHI_SPACES_ADMIN_PASSWORD=<change-me>
#   PHI_SPACES_LLM=1
#   SWARM_AGENTS=100
#   SWARM_RATE=5
#   SWARM_REMOTE=tcp:<nano-internal-ip>:3600
#   # …or via an SSH tunnel when no direct route exists (serveSpace has no TLS):
#   #   big:  ssh -N -L 127.0.0.1:3600:127.0.0.1:3600 nano   (or systemd user unit)
#   #   .env: SWARM_REMOTE=tcp:127.0.0.1:3600    (container uses network_mode: host)
#
# Example: shard host `nano` — .env next to docker-compose.yml
#          (start with: npm run docker:nano:up)
#
#   SWARM_LISTEN=tcp:0.0.0.0:3600  # or bind internal IP via SWARM_BIND=… in shell env
#   SWARM_BIND=127.0.0.1           # loopback only — reachable through the SSH tunnel
#   SWARM_DB=/data/swarm-b.sqlite  # inside container volume swarm-nano-data
#   SWARM_TAG=b-
#   SWARM_PRODUCE=0                # hub produces; set 1 to let nano produce too
# ---------------------------------------------------------------------------
