# spaces-files: copy to spaces-files/.env (ignored by git). Every variable is optional; the comments give the
# defaults. Values already in the environment win over this file (server/env.ts). The full list with explanations is
# the head comment of server/launch.ts; the operator guide (docs/operator-guide.en.md) covers deployment.
#
# Without a .env:
#   - locally (`npm run spaces-files`): the three directories under spaces-files/.local/ (data, state, blobs), the
#     Space process server/space-host.ts, HTTPS on https://localhost:4200 with the development IdP;
#   - in Docker (docker/docker-compose.yml, `npm run docker:big:rust:up`): the named volume `phi-spaces-files_files`
#     at /srv/files in the container, holding data/, state/, blobs/, keys/ (the backup keys) and outbox/ (backups
#     before they are copied out); the image sets the three directories and the Rust Space process, the compose file
#     sets password sign-in, plain HTTP on 127.0.0.1:4200 behind nginx and the public origin. `docker volume inspect
#     phi-spaces-files_files` shows where the volume lies on the host. The compose file's `environment` wins over
#     this file for the variables it sets.

# ---- Directories (mode 700 each, apart from each other) ----
# FILES_DATA_DIR=/srv/spaces-files/data      # the store (files.sqlite and WAL), the state marker, space.sock
# FILES_STATE_DIR=/srv/spaces-files/state    # sessions, keys, epoch, roster, passwords, operator.sock; never inside the data dir
# FILES_BLOB_DIR=/srv/spaces-files/blobs     # the file contents, sealed with AES-256-GCM
# FILES_MEM=1                                # everything in memory, thrown away on exit (no operator socket)

# ---- The Space process ----
# FILES_SPACE_SERVER=ts                      # ts (default): server/space-host.ts; a path: a binary (the Rust one,
#                                            # rust/target/release/files-space); inprocess: the store in this process

# ---- Browser ----
# FILES_PUBLIC_ORIGIN=https://localhost:4200 # the origin browsers use; every mutation's Origin is checked against it
# FILES_HTTP_HOST=127.0.0.1                  # where the browser adapter listens
# FILES_HTTP_PORT=4200                       # default: the origin's port
# FILES_TLS_CERT=.local/tls/cert.pem         # `npm run dev-cert` makes a self-signed pair for localhost;
# FILES_TLS_KEY=.local/tls/key.pem           # without a pair (and without FILES_HTTP_PLAIN) the browser adapter stays off
# FILES_HTTP_PLAIN=1                         # plain HTTP, only on a loopback FILES_HTTP_HOST, behind a TLS proxy
# FILES_LOGIN=password                       # username and password (`npm run operator -- set-password <name>`)
#                                            # instead of an OpenID provider
# FILES_OIDC_ISSUER=                         # the OpenID provider; default the development IdP
# FILES_OIDC_CLIENT_ID=                      # (`npm run dev-idp`, http://127.0.0.1:4201, loopback only)
# FILES_OIDC_CLIENT_SECRET=
# FILES_OIDC_CA=                             # a PEM file, when the provider's certificate is not publicly trusted
# FILES_DEV_IDP_PORT=4201                    # the development IdP's port

# ---- Agent hosts ----
# FILES_AGENT_SOCKETS=hostPeer@tenant=/path/to.sock;…   # one unix socket per enrolled agent host and tenant
# FILES_AGENT_NET=0.0.0.0:4202               # agent hosts on other machines over TLS (with FILES_TLS_CERT/_KEY);
#                                            # hosts enroll with `npm run operator -- enroll-host <peer> <tenant,…>`
# FILES_AGENT_NET_ID=spaces-files            # the service ID in each key-proof challenge

# ---- Backups (`npm run operator -- new-backup-key <file>`; keep copies of the keys off this host) ----
# FILES_BACKUP_KEY=/secure/data.key          # encrypts the data backups
# FILES_STATE_BACKUP_KEY=/secure/state.key   # encrypts the deployment-state backups

# ---- Standby on another machine (server/standby-host.ts; operator guide, standby) ----
# FILES_STANDBY=standby.example:4203         # every state change and blob reaches it before it is answered
# FILES_STANDBY_CERT=                        # this service's client certificate and key
# FILES_STANDBY_KEY=
# FILES_STANDBY_CA=                          # what signed the standby's certificate
# FILES_STANDBY_NAME=                        # the name in the standby's certificate (default: the host)

# ---- Limits, mounts, upkeep ----
# FILES_LIMITS=/path/limits.json             # overrides of server/limits.ts, checked on start
# FILES_MOUNTS=/path/mounts.json             # read-only directory mounts, each the workspace @<name>
# FILES_UPKEEP_MS=600000                     # each tenant's upkeep (expired receipts, …); 0 turns it off
