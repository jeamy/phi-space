{
  "name": "pi-spaces",
  "version": "0.0.1",
  "type": "module",
  "description": "JavaSpaces-style space for @earendil-works/pi-durable",
  "main": "dist/index.js",
  "scripts": {
    "test": "node --experimental-strip-types --test test-core.test.ts test-meter.test.ts integration.test.ts",
    "example": "node --experimental-strip-types examples/workers.ts",
    "example:pipeline": "node --experimental-strip-types examples/sensor-pipeline.ts",
    "example:chat": "node --experimental-strip-types examples/chat.ts",
    "example:arxiv": "node --experimental-strip-types examples/arxiv-research.ts",
    "typecheck": "tsc",
    "build": "tsc -p tsconfig.build.json",
    "bundle": "node scripts/bundle-mobile.mjs",
    "test:examples": "node --experimental-strip-types --test test/examples/*.test.ts",
    "example:golomb": "node --experimental-strip-types examples/golomb.ts",
    "example:dark-energy": "node --experimental-strip-types examples/dark-energy-research.ts",
    "example:sieve": "node --experimental-strip-types examples/sieve.ts",
    "example:cache": "node --experimental-strip-types examples/cache.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-durable": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "esbuild": "^0.25.0"
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ]
}
