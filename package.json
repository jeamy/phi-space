{
  "name": "phi-spaces-repository",
  "private": true,
  "type": "module",
  "description": "The phi-spaces repository: the package in spaces/, the applications beside it. These scripts run the repository-wide checks and forward to spaces/ and the applications (docs/umstellung-verzeichnisse.en.md, D3); the package name and its exports are spaces/package.json's.",
  "scripts": {
    "test": "node checks/layering.mjs && node checks/durable-imports.mjs --check && node checks/package-imports.mjs --check && node checks/root-scripts.mjs && node --test checks/shared-copies.test.mjs && npm --prefix spaces test",
    "vectors": "node --experimental-strip-types --no-warnings spaces/test/vectors/build.ts --write",
    "example": "node --experimental-strip-types spaces/agent/examples/workers.ts",
    "example:pipeline": "node --experimental-strip-types spaces/examples/sensor-pipeline.ts",
    "example:chat": "node --experimental-strip-types spaces/agent/examples/chat.ts",
    "example:arxiv": "node --experimental-strip-types spaces/agent/examples/arxiv-research.ts",
    "typecheck": "npm --prefix spaces run typecheck --",
    "typecheck:agent": "npm --prefix spaces run typecheck:agent --",
    "test:agent": "npm --prefix spaces run test:agent --",
    "build": "npm --prefix spaces run build --",
    "bundle": "node spaces/scripts/bundle-mobile.mjs",
    "testbed": "bash spaces/test/testbed/testbed.sh",
    "testbed:federation": "node --experimental-strip-types --no-warnings spaces/test/testbed/local-federation/run.ts",
    "test:examples": "node --experimental-strip-types --test spaces/test/examples/*.test.ts",
    "example:golomb": "node --experimental-strip-types spaces/examples/golomb.ts",
    "example:dark-energy": "node --experimental-strip-types spaces/agent/examples/dark-energy-research.ts",
    "space-server": "node --experimental-strip-types --no-warnings spaces/src/standalone.ts",
    "example:sieve": "node --experimental-strip-types spaces/examples/sieve.ts",
    "example:codemode-evolve": "node --experimental-strip-types spaces/examples/codemode-evolve.ts",
    "example:codemode-evolve:live": "node --experimental-strip-types spaces/agent/examples/codemode-evolve-live.ts",
    "example:cache": "node --experimental-strip-types spaces/examples/cache.ts",
    "example:blocking": "node --experimental-strip-types spaces/agent/examples/blocking-tool.ts",
    "tui": "node --no-warnings --experimental-strip-types spaces/test/tui/cli.ts",
    "bootstrap": "node --no-warnings --experimental-strip-types spaces/scripts/bootstrap-spaces.ts",
    "dashboard": "node --experimental-strip-types spaces/src/dashboard.ts",
    "dashboard:start": "bash spaces/scripts/dashboard.sh start",
    "dashboard:stop": "bash spaces/scripts/dashboard.sh stop",
    "dashboard:status": "bash spaces/scripts/dashboard.sh status",
    "build:operations": "node spaces/scripts/build-operations.mjs",
    "check:branding": "node checks/branding.mjs",
    "check:durable": "node checks/durable-imports.mjs --check",
    "check:package": "node checks/package-imports.mjs --check",
    "check:layering": "node checks/layering.mjs",
    "check:root-scripts": "node checks/root-scripts.mjs",
    "codemode-chat": "npm --prefix codemode-chat start",
    "codemode-chat:dev": "npm --prefix codemode-chat run dev",
    "test:codemode-chat": "npm --prefix codemode-chat test",
    "codemode-forum": "npm --prefix codemode-forum start",
    "codemode-forum:dev": "npm --prefix codemode-forum run dev",
    "test:codemode-forum": "npm --prefix codemode-forum test",
    "example:space-chat": "node --experimental-strip-types help-site/examples/v1-local-memory/run.ts",
    "help": "npm --prefix help-site run dev"
  }
}
