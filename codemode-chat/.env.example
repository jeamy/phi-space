PORT=3700
CODEMODE_BIND=0.0.0.0
# empty = publish on all interfaces (IPv4 + IPv6, so http://localhost works); set 127.0.0.1 to restrict
HOST_BIND=

# Optional: explicitly enable model agents (Mistral codestral / newest haiku) with configured credentials; costs tokens
CODEMODE_CHAT_LLM=0          # enable explicitly with 1 only when live model calls are intended
# CODEMODE_CHAT_MODEL=codestral  # substring of the default model
# CODEMODE_LLM_PER_MIN=20        # model calls per minute for all contenders together
# CODEMODE_LLM_PER_DAY=500       # model calls per day (cost cap: any visitor can start a model run)
# ANTHROPIC_API_KEY=sk-…   # or MISTRAL_API_KEY / OPENAI_API_KEY / mistral via pi CLI auth.json
# PI_AUTH_DIR=~/.pi/agent  # dev container mounts this read-only to /home/node/.pi/agent

# ---- Access and limits (hub) ----
# CODEMODE_ADMIN_TOKEN=    # POST /api/llm (model agents on/off, default model) needs header x-admin-token; unset = off
# CODEMODE_REQ_PER_MIN=120 # API requests and WebSocket connects per client IP and minute (behind a reverse proxy the
#                          # client IP comes from X-Forwarded-For, see deploy/nginx-codemode.conf)
# CODEMODE_DEV_ORIGINS=    # dev mode only: extra hosts the page may be opened from (comma-separated, e.g. a LAN IP);
#                          # localhost and 127.0.0.1 always work

# ---- Storage and lifetime (hub and shard) ----
# CODEMODE_SQLITE=       # hub store (default: codemode-chat/.local/codemode-chat.sqlite; docker: the /data volume)
# CODEMODE_TTL_HOURS=24  # lifetime of a room's entries (blocks, contributions, verdicts, log) in hours; 0 = until the
#                        # block is deleted. Set the same value on hub and shard. Rooms stay capped either way
#                        # (60 blocks, 1000 contributions, 500 log lines).
# CODEMODE_MAX_TIMEOUT_S=60  # the longest time limit per contribution a custom task may choose; the form's field
#                            # follows it. Set the same value on hub and shard. A long limit keeps one of the two
#                            # judge slots per process busy that long (e.g. 3600 = up to an hour per contribution)
# CODEMODE_HOST_NAME=    # name in the test-system bar (default: hostname), e.g. big / nano
# PI_CODEMODE_DIR=       # load pi-codemode from a checkout (<dir>/dist/index.js) instead of node_modules

# ---- Optional: judge shard on another host (server/nano-host.ts) ----
# hub side
# CODEMODE_REMOTE=                     # unix:/tmp/codemode-b.sock  or  tcp:nano:3800
# CODEMODE_REMOTE_NAME=nano            # the shard's label in the system bar while it is unreachable
# CODEMODE_REMOTE_CONNECT_TIMEOUT=5000 # ms to open the socket
# CODEMODE_REMOTE_TIMEOUT=20000        # ms one request may stay unanswered before the socket is reopened
# CODEMODE_REMOTE_CALL_TIMEOUT=8000    # ms per call attempt
# CODEMODE_REMOTE_ATTEMPTS=3           # attempts per call
# shard side
# CODEMODE_LISTEN=                     # unix:/path.sock  or  tcp:0.0.0.0:3800
# CODEMODE_SHARD_BIND=127.0.0.1        # docker: host address that publishes :3800 (default loopback); never a public one
# CODEMODE_DB=/data/codemode-b.sqlite  # shard storage (durable; CODEMODE_MEM=1 = in-memory, throwaway)
# CODEMODE_JUDGES=2                    # parallel sandbox workers on the shard

# ---------------------------------------------------------------------------
# Example: local development (`npm --prefix codemode-chat run shards:start` starts hub + nano over a unix socket)
#
#   PORT=3700
#   CODEMODE_BIND=0.0.0.0
#   HOST_BIND=
#   CODEMODE_REMOTE=unix:/tmp/codemode-b.sock
#
# Example: production on `big` — .env next to docker-compose.yml's parent (codemode-chat/.env)
#
#   PORT=3700
#   HOST_BIND=127.0.0.1            # only the reverse proxy, not public
#   CODEMODE_HOST_NAME=big
#   CODEMODE_CHAT_LLM=1
#   CODEMODE_LLM_PER_DAY=500
#   CODEMODE_ADMIN_TOKEN=<random, e.g. openssl rand -hex 24>
#   CODEMODE_TTL_HOURS=24          # the same value as on nano
#   CODEMODE_REMOTE=tcp:<nano-internal-ip>:3800
#   # …or via an SSH tunnel when no direct route exists (serveSpace has no TLS):
#   #   big:  ssh -N -L 127.0.0.1:3800:127.0.0.1:3800 nano   (or a systemd user unit)
#   #   .env: CODEMODE_REMOTE=tcp:127.0.0.1:3800    (the container uses network_mode: host)
#
# Example: shard host `nano` — its own codemode-chat/.env (start with: npm --prefix codemode-chat run docker:nano:up)
#
#   CODEMODE_LISTEN=tcp:0.0.0.0:3800  # inside the container; what the host publishes is CODEMODE_SHARD_BIND
#   CODEMODE_SHARD_BIND=127.0.0.1     # default: loopback only, reachable through the SSH tunnel; or an internal IP
#   CODEMODE_HOST_NAME=nano
#   CODEMODE_JUDGES=2
#   CODEMODE_TTL_HOURS=24             # the same value as on big
# ---------------------------------------------------------------------------
