# Copy to codemode-chat/.env (next to package.json). Everything is optional.
PORT=3700
CODEMODE_BIND=0.0.0.0          # direct start; the Docker hub always publishes via CODEMODE_HOST_BIND
CODEMODE_HOST_PORT=3700        # published port (docker)
CODEMODE_HOST_BIND=127.0.0.1   # only the reverse proxy; 0.0.0.0 to publish
CODEMODE_HOST_NAME=big         # name of the hub in the system bar
CODEMODE_NANO_NAME=nano        # name of the docker nano service in the system bar

# Optional: explicitly enable model agents (Mistral codestral / newest haiku); costs tokens
CODEMODE_CHAT_LLM=0
# CODEMODE_CHAT_MODEL=codestral  # substring of the default model
# MISTRAL_API_KEY=… / ANTHROPIC_API_KEY=…   # or mount ~/.pi/agent (PI_AUTH_DIR)

# ---- Optional: judge shard on another host (server/nano-host.ts) ----
# CODEMODE_REMOTE=       # hub side: unix:/tmp/codemode-b.sock  or  tcp:nano:3800
# CODEMODE_LISTEN=       # shard host side: unix:/path.sock  or  tcp:0.0.0.0:3800
# CODEMODE_DB=/data/codemode-b.sqlite   # shard storage (durable; CODEMODE_MEM=1 = in-memory, throwaway)
# CODEMODE_JUDGES=2      # parallel sandbox workers on the shard
# CODEMODE_SHARD_BIND=   # docker nano: bind the shard port to this internal IP

# ---------------------------------------------------------------------------
# Example: hub on `big`      CODEMODE_HOST_NAME=big   CODEMODE_REMOTE=tcp:<nano-internal-ip>:3800
#          (or through an SSH tunnel: ssh -N -L 127.0.0.1:3800:127.0.0.1:3800 nano and CODEMODE_REMOTE=tcp:host.docker.internal:3800)
# Example: shard on `nano`   CODEMODE_HOST_NAME=nano  CODEMODE_SHARD_BIND=127.0.0.1   (start: npm run docker:nano:up)
# ---------------------------------------------------------------------------
