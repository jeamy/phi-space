PORT=3700
CODEMODE_BIND=0.0.0.0
# empty = publish on all interfaces (IPv4 + IPv6, so http://localhost works); set 127.0.0.1 to restrict
HOST_BIND=

# Optional: explicitly enable model agents (Mistral codestral / newest haiku) with configured credentials; costs tokens
CODEMODE_CHAT_LLM=0          # enable explicitly with 1 only when live model calls are intended
# CODEMODE_CHAT_MODEL=codestral  # substring of the default model
# CODEMODE_VERIFIER_MODEL=haiku  # part of the model id the verifier agent writes check rules with (default haiku)
# CODEMODE_CRITIC_MODEL=haiku    # part of the model id that writes critiques first on the work board (default haiku)
# CODEMODE_LLM_PER_MIN=20        # model calls per minute for all contenders together
# CODEMODE_LLM_PER_DAY=500       # model calls per day (cost cap: any visitor can start a model run)
# CODEMODE_SEARCH_PER_DAY=100    # web searches per day of the research agents (DuckDuckGo; research needs the admin login)
# CODEMODE_RUN_BUDGET_TOKENS=300000  # a visitor's run: default token budget and the most it may ask for; 0 = none (admin runs: no default)
# CODEMODE_TOKENS_PER_IP_DAY=1000000 # tokens all visitor runs of one address may use per day; 0 = no limit
# CODEMODE_EARLIER_DAYS=30       # how long accepted results stay as material for later, similar tasks; 0 = always
# CODEMODE_CROSS_WAIT_S=300      # text tasks: how long a judgement waits for a judge of another model than the author's; 0 = no wait
# ANTHROPIC_API_KEY=sk-…   # or MISTRAL_API_KEY / OPENAI_API_KEY / mistral via pi CLI auth.json
# PI_AUTH_DIR=~/.pi/agent  # the model container mounts this read-only to /home/node/.pi/agent. Rootless Docker (the servers): the host user is root in the container, a 0600 auth.json is then unreadable for the node user (no models listed): point this at a copy owned by container uid 1000, as the help system does (help-site/README.md, PI_AUTH_DIR)

# ---- Access and limits (hub) ----
# CODEMODE_ADMIN_PASSWORD=  # the admin login (panel at the bottom left: model agents on/off, allowed models, research); scripts may send it as the header x-admin-token; unset = no admin (older name: CODEMODE_ADMIN_TOKEN)
# CODEMODE_REQ_PER_MIN=120 # API requests and WebSocket connects per client IP and minute (behind a reverse proxy the
#                          # client IP comes from X-Forwarded-For, see deploy/nginx-codemode.conf)
# CODEMODE_DEV_ORIGINS=    # dev mode only: extra hosts the page may be opened from (comma-separated, e.g. a LAN IP);
#                          # localhost and 127.0.0.1 always work

# ---- The one space and the processes around it (docs/codemode-space-architektur.md) ----
# Every role is its own process; they talk only through the one space. `npm run dev` / `npm start` (server/launch.ts)
# start them all on this machine; `npm run space|judge|web` start one.
# CODEMODE_ROLES=space,judge,agents,model,web   # what server/launch.ts starts here (default all)
# space process
# CODEMODE_LISTEN=unix:/tmp/codemode-space.sock   # where the space is served: unix:/path or tcp:0.0.0.0:3800 (no TLS:
#                                                 # an internal address or an SSH tunnel, never a public interface)
# CODEMODE_SQLITE=       # the store (default: codemode-chat/.local/codemode-space.sqlite; docker: the /data volume)
# CODEMODE_MEM=1         # in memory instead, throwaway
# every other process
# CODEMODE_SPACE=unix:/tmp/codemode-space.sock    # where the space is: unix:/path or tcp:<host>:3800
# CODEMODE_SPACE_CALL_TIMEOUT=30000              # ms one call to the space may take (a blocking wait stays below it)
# CODEMODE_SPACE_CONNECT_TIMEOUT=5000            # ms to open the socket
# CODEMODE_HOST_NAME=    # name in the system bar and on the tiles (default: hostname), e.g. big / nano
# judge process
# CODEMODE_JUDGES=2      # parallel judges (sandboxes) in one judge process
# CODEMODE_JUDGE_LEASE_MS=        # a judge's transaction lease: a candidate of a judge that died is back within it (default: CODEMODE_MAX_TIMEOUT_S + 30 s; the sandbox blocks renewals while a case runs)
# agents process
# CODEMODE_AGENT_SLOTS=16         # agents one agents process works as at most at once
# CODEMODE_AGENT_LEASE_MS=60000   # lease of an agent's slot and work item: the work of an agents process that died is back within it
# CODEMODE_MODEL_WAIT_S=600       # how long an agent waits for the answer of a model call; also all calls of creating a task together
# CODEMODE_VERDICT_WAIT_S=        # how long a run waits for a contribution's verdict before it goes on without one (unset: the judge's worst case; text: 600)
# model process (the only one that needs model credentials)
# CODEMODE_MODEL_PARALLEL=2       # model calls one model process makes at once

# ---- Lifetime of the entries ----
# CODEMODE_TTL_HOURS=24  # lifetime of a room's entries (blocks, contributions, verdicts, log) in hours; 0 = until the
#                        # block is deleted. Rooms stay capped either way (60 blocks, 1000 contributions, 500 log lines).
# CODEMODE_MAX_TIMEOUT_S=60  # the longest time limit per contribution a custom task may choose; the form's field
#                            # follows it. A long limit keeps one judge busy that long (e.g. 3600 = up to an hour)
# PI_CODEMODE_DIR=       # load pi-codemode from a checkout (<dir>/dist/index.js) instead of node_modules

# ---------------------------------------------------------------------------
# Example: local development (`npm --prefix codemode-chat run dev` starts space, judge, agents, model and web; the space on a unix socket)
#
#   PORT=3700
#   CODEMODE_BIND=0.0.0.0
#   HOST_BIND=
#
# Docker (docker/docker-compose.yml, one container per role):
#   npm --prefix codemode-chat run docker:nano:up    on nano: space (SQLite in a volume) and a judge
#   npm --prefix codemode-chat run docker:big:up     on big: web, a judge, agents, the model process
#   npm --prefix codemode-chat run docker:prod:up    both on one host
#   npm --prefix codemode-chat run docker:local:up   both on one machine as a test bed (port 3710, nano capped at 2 CPUs)
#
# On nano:
#   CODEMODE_SPACE_BIND=10.x.y.z    # nano's internal (LAN/NetBird) address the space is published on (default 127.0.0.1)
#   CODEMODE_SPACE_PORT=3800        # host port of the space
#   NANO_JUDGES=1                   # judges in nano's judge container
#   NANO_CPUS=                      # cap the nano containers' CPUs (empty: no cap)
#   NANO_HOST_NAME=nano
#
#   CODEMODE_BACKUP_KEEP=7         # backups of the space kept (npm --prefix codemode-chat run docker:backup)
#
# On big:
#   CODEMODE_SPACE=tcp:10.x.y.z:3800   # nano's space (default tcp:space:3800, the space container of the same project)
#   HOST_BIND=127.0.0.1                # the web port only for the reverse proxy (deploy/Caddyfile, deploy/nginx-codemode.conf)
#   BIG_JUDGES=2
#   BIG_HOST_NAME=big
#   PI_AUTH_DIR=~/.pi/agent            # model credentials, mounted into the model container only
# ---------------------------------------------------------------------------
