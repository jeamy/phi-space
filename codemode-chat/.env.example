# Copy to codemode-chat/.env (next to server/ and docker/). Everything is optional.
CODEMODE_HOST_PORT=3700        # published port
CODEMODE_HOST_BIND=127.0.0.1   # only the reverse proxy; 0.0.0.0 to publish
CODEMODE_CHAT_LLM=0            # 1 = model agents (Mistral codestral / newest haiku), costs tokens
# CODEMODE_CHAT_MODEL=codestral  # substring of the default model
# ANTHROPIC_API_KEY=… / MISTRAL_API_KEY=…  # or mount ~/.pi/agent (PI_AUTH_DIR)
