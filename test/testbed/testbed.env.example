# Settings for test/testbed/testbed.sh. Copy to testbed.env (git-ignored) and adjust.
# Environment variables win over this file. Values are plain KEY=VALUE lines; the file is parsed, never executed.

# --- server access (ssh alias from ~/.ssh/config, or user@host)
TESTBED_SSH_TARGET=big
#TESTBED_SSH_USER=deploy
#TESTBED_SSH_PORT=22
#TESTBED_SSH_KEY=~/.ssh/
#TESTBED_SSH_OPTS=-o StrictHostKeyChecking=accept-new
# A key or agent is preferred. A password needs sshpass; keep this file out of git (it is) and out of backups.
#TESTBED_SSH_PASSWORD=
# 1 (default): never prompt (BatchMode). 0: allow a passphrase/password prompt in the terminal.
#TESTBED_SSH_BATCH=1

# --- where on the server
TESTBED_REMOTE_DIR=/media/docker/phi-spaces
# Run the remote commands through `sudo -n`. Not needed when the ssh user owns the directory and the docker daemon.
#TESTBED_SUDO=no
# Rootless docker: the socket is detected (/run/user/<uid>/docker.sock). Set it only if that is wrong.
#TESTBED_DOCKER_HOST=unix:///run/user/<uid>/docker.sock

# --- containers (written to the server's .env on first init; later changes: edit that file or `init --force` + rm .env)
TESTBED_PROJECT=phi-spaces-test
#TESTBED_NODE_IMAGE=node:22-bookworm-slim
#TESTBED_RUNNER_MEM=2g
#TESTBED_RUNNER_CPUS=2.0
#TESTBED_MEM_LIMIT=512m
#TESTBED_CPUS=0.5
#TESTBED_PIDS_LIMIT=1024
