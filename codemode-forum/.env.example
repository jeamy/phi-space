# codemode-forum: copy to codemode-forum/.env. Every process reads it itself; real environment variables win.
PORT=4100
FORUM_BIND=127.0.0.1

# ---- Models (the model process; cost tokens) ----
FORUM_LLM=0                      # enable explicitly with 1 only when live model calls are intended
# FORUM_MODELS=haiku,codestral,gpt  # parts of model ids that may take part until an admin chooses; empty = none
# FORUM_LLM_PER_MIN=20             # model calls per minute, all model processes together
# FORUM_LLM_PER_DAY=500            # model calls per UTC day
# FORUM_MODEL_PARALLEL=2           # model calls one model process makes at once
# FORUM_MODEL_WAIT_S=600           # how long an agent waits for the answer of a model call
# FORUM_AUTH_FILE=                 # the model process's credential file (logins of the page); default .local/auth/credentials.json
# FORUM_AUTH_SEED=                 # filled once from this file while it does not exist; default ~/.pi/agent/auth.json, empty: none
# FORUM_RUN_BUDGET_TOKENS=300000   # a visitor's run: default token budget and the most it may ask for
# FORUM_TOKENS_PER_IP_DAY=1000000  # tokens all visitor runs of one address may use per day; 0 = no limit
# ANTHROPIC_API_KEY=sk-…           # or another provider's key, or the pi CLI login (~/.pi/agent/auth.json)

# ---- Access and limits (web) ----
# FORUM_ADMIN_PASSWORD=            # the admin login (models on/off, allowed models); scripts may send it as x-admin-token
#                                  # (with FORUM_LOGIN only scripts: administrators are then named in FORUM_ADMINS)
# FORUM_LOGIN=oidc                 # sign-in at an OpenID provider (server/auth.ts); unset: open, for play on one machine
# FORUM_PUBLIC_ORIGIN=http://localhost:4100   # the browser's origin: https, or http on a loopback name
# FORUM_OIDC_ISSUER=http://localhost:4300/realms/phi   # the provider (idp/ at the repository root)
# FORUM_OIDC_CLIENT_ID=codemode-forum
# FORUM_OIDC_CLIENT_SECRET=        # IDP_FORUM_SECRET of idp/.env
# FORUM_OIDC_CA=                   # a PEM file, for a provider with a certificate of its own
# FORUM_ADMINS=                    # administrators by identity: `issuer subject;issuer subject`
# FORUM_TLS_CERT= FORUM_TLS_KEY=   # PEM files: https here, for a test from a phone on the LAN (idp/README.md); on the servers nginx ends TLS
# FORUM_REQ_PER_MIN=120            # API requests and WebSocket connects per client IP and minute
# FORUM_DEV_ORIGINS=               # further hosts the Next.js dev server serves (comma-separated)

# ---- Space and processes ----
# FORUM_ROLES=space,sources,checker,agents,model,web  # which roles `npm start` / `npm run dev` start here
# FORUM_LISTEN=unix:/tmp/codemode-forum-space.sock   # where the space listens (tcp:0.0.0.0:4180 for other hosts)
# FORUM_SPACE=unix:/tmp/codemode-forum-space.sock    # where the others find it
# FORUM_SQLITE=                    # the store; default codemode-forum/.local/forum-space.sqlite
# FORUM_MEM=1                      # keep the space in memory (throwaway)
# FORUM_SPACE_SERVER=rust/target/release/forum-space   # the Rust space server instead of server/space-host.ts (cd rust && cargo build --release)
# FORUM_MAX_CLAIM_MIB=1024         # capacity of the persistent space; FORUM_MAX_DOC_MIB (1280) must exceed it
# FORUM_HOST_NAME=                 # name in the system bar (default: the hostname)
# FORUM_AGENT_SLOTS=16             # agents one agents process works as at once
# FORUM_AGENT_LEASE_MS=60000       # when a dead agent's work is back
# FORUM_REPLY_WAIT_S=300           # how long the table waits for a model's reply to a question or proposal
# FORUM_TURN_WAIT_S=600            # table A: how long a model has for its turn, and for each section it revises in it
# FORUM_PERSON_WAIT_S=120          # how long the kickoff waits for the person's answers; 0 = not at all
# FORUM_IDLE_WAIT_MS=60000         # how long an idle role waits for work in one request
# FORUM_TTL_HOURS=8760             # lifetime of a room's entries; 0 = for good
# FORUM_BACKUP_KEEP=7              # backups of the space kept (npm run backup)

# ---- Sources (the sources process; read-only) ----
# FORUM_REPOS=name=/abs/path,other=/abs/path   # local git repositories a task may read in (admin only); empty = none
# FORUM_GIT_HOSTS=github.com      # hosts a remote repository may be fetched from over https (admin only); empty = off
# FORUM_GIT_MAX_MB=200             # the most one fetched repository may take on the disk
# FORUM_GIT_TIMEOUT_S=60           # the longest one fetch may take
# FORUM_GIT_CACHE=                 # where fetched repositories are kept (bare); default codemode-forum/.local/git-cache
# FORUM_SOURCE_PARALLEL=4          # reading calls one sources process answers at once
# FORUM_SOURCE_LEASE_MS=20000      # when a dead sources process's request is back
# FORUM_SOURCE_WAIT_S=30           # how long a caller waits for the sources process

# ---- Checker (the checker process; no model) ----
# FORUM_CHECK_WAIT_S=60            # how long an agent waits for the checker
# FORUM_CHECK_LEASE_MS=30000       # when a dead checker's request is back

# ---- Docker (npm run docker:local:up; docker/docker-compose.yml) ----
# FORUM_REPOS_DIR=/abs/dir         # mounted read-only into the sources container at /repos; default: an empty directory
# FORUM_DOCKER_REPOS=name=/repos/name   # the repositories as that container sees them (FORUM_REPOS above names paths of this machine)
# PI_AUTH_DIR=                     # the pi CLI login mounted into the model container; default ~/.pi/agent

# spaces-files (the sources process only; server/files.ts): its agent socket for this host, the tenant and the host peer
# it stands for; empty: rooms cannot be linked to a workspace. FORUM_FILES_MAX_FILES (400), _MAX_TEXT_KB (4000),
# _MAX_DEPTH (8), _MAX_READ_MB (64), FORUM_FILES_WAIT_S (120)
FORUM_FILES_SOCKET=
FORUM_FILES_TENANT=
FORUM_FILES_HOST=
# the address of spaces-files' page (https), named beside a copy's files; empty: none
# FORUM_FILES_PAGE=

# PDFs (docs/forum-seite-plan-2026-11-26.en.md, phase 6): the sandbox process (server/sandbox-host.ts) takes their text
# out, each in a child isolated by user namespaces, or in Docker by the pdf worker's container without a network
# (FORUM_PDF_WORKER, its socket; set in docker-compose.yml). Without either no PDF is opened.
# FORUM_PDF_MAX_PAGES=300          # a PDF with more pages is named, not read
# FORUM_PDF_MAX_TEXT_KB=2000       # the text of one PDF at most
# FORUM_PDF_TIMEOUT_S=30           # one PDF's reading at most
# FORUM_PDF_MEMORY_MB=256          # the reader's heap
# FORUM_PDF_WAIT_S=60              # how long the sources process waits for a PDF's text
