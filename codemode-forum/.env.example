# codemode-forum: copy to codemode-forum/.env. Every process reads it itself; real environment variables win.
PORT=4100
FORUM_BIND=127.0.0.1

# ---- Models (the model process; cost tokens) ----
FORUM_LLM=0                      # enable explicitly with 1 only when live model calls are intended
# FORUM_MODELS=haiku,codestral,gpt  # parts of model ids that may take part until an admin chooses; empty = none
# FORUM_LLM_PER_MIN=20             # model calls per minute, all model processes together
# FORUM_LLM_PER_DAY=500            # model calls per UTC day
# FORUM_MODEL_PARALLEL=2           # model calls one model process makes at once
# FORUM_MODEL_WAIT_S=600           # how long an agent waits for the answer of a model call
# FORUM_RUN_BUDGET_TOKENS=300000   # a visitor's run: default token budget and the most it may ask for
# FORUM_TOKENS_PER_IP_DAY=1000000  # tokens all visitor runs of one address may use per day; 0 = no limit
# ANTHROPIC_API_KEY=sk-…           # or another provider's key, or the pi CLI login (~/.pi/agent/auth.json)

# ---- Access and limits (web) ----
# FORUM_ADMIN_PASSWORD=            # the admin login (models on/off, allowed models); scripts may send it as x-admin-token
# FORUM_REQ_PER_MIN=120            # API requests and WebSocket connects per client IP and minute
# FORUM_DEV_ORIGINS=               # further hosts the Next.js dev server serves (comma-separated)

# ---- Space and processes ----
# FORUM_ROLES=space,sources,agents,model,web  # which roles `npm start` / `npm run dev` start here
# FORUM_LISTEN=unix:/tmp/codemode-forum-space.sock   # where the space listens (tcp:0.0.0.0:4180 for other hosts)
# FORUM_SPACE=unix:/tmp/codemode-forum-space.sock    # where the others find it
# FORUM_SQLITE=                    # the store; default codemode-forum/.local/forum-space.sqlite
# FORUM_MEM=1                      # keep the space in memory (throwaway)
# FORUM_SPACE_SERVER=              # a binary to run as the space process instead of server/space-host.ts
# FORUM_MAX_CLAIM_MIB=1024         # capacity of the persistent space; FORUM_MAX_DOC_MIB (1280) must exceed it
# FORUM_HOST_NAME=                 # name in the system bar (default: the hostname)
# FORUM_AGENT_SLOTS=16             # agents one agents process works as at once
# FORUM_AGENT_LEASE_MS=60000       # when a dead agent's work is back
# FORUM_IDLE_WAIT_MS=60000         # how long an idle role waits for work in one request
# FORUM_TTL_HOURS=8760             # lifetime of a room's entries; 0 = for good
# FORUM_BACKUP_KEEP=7              # backups of the space kept (npm run backup)

# ---- Sources (the sources process; read-only) ----
# FORUM_REPOS=name=/abs/path,other=/abs/path   # local git repositories a task may read in (admin only); empty = none
# FORUM_SOURCE_PARALLEL=4          # reading calls one sources process answers at once
# FORUM_SOURCE_LEASE_MS=20000      # when a dead sources process's request is back
# FORUM_SOURCE_WAIT_S=30           # how long a caller waits for the sources process
