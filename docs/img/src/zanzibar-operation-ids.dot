digraph "Lifetime of an operation ID" {
#include
	issue [label="issueOperationIds\nsigned over tenant, actor, issue time,\nkey generation and a random nonce"];
	use [label="Mutation with the ID\nreceipt expires at issue time + retry window", fillcolor="#d8eeea"];
	retry [label="Retry inside the window\nthe receipt answers, no second write", fillcolor="#d8eeea"];
	late [label="After the window\nID rejected before receipt lookup;\nmaintenance may delete the receipt", fillcolor="#fcf2d9"];
	restore [label="Restore from backup\noperator installs a new signing key", fillcolor="#fcf2d9"];
	dead [label="Every earlier ID is rejected\nrestored receipts cannot answer", fillcolor="#f8e9e5"];
	issue -> use;
	use -> retry [label="reply lost"];
	use -> late [label="window ends"];
	restore -> dead;
	{rank=same; retry; late}
}
