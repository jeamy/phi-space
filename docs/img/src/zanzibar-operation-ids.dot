digraph "Lifetime of an operation ID" {
#include
  issue [label="Issue a signed ID for one tenant and actor\nExpiry = issue time + retry window"];
  use [label="Commit mutation, receipt and audit together",fillcolor="#d8eeea"];
  retry [label="Lost reply • retry with the same ID"];
  verify [label="Verify session, signature, generation\nand expiry against nondecreasing time"];
  auth [label="Check current authorization"];
  result [label="Matching digest → recorded outcome\nDifferent digest → requestMismatch",fillcolor="#d8eeea"];
  expired [label="Reject ID before lookup\nRestore invalidates prior generations",fillcolor="#fcf2d9"];
  denied [label="Deny request\nKeep receipt contents private",fillcolor="#f8e9e5"];
  issue -> use -> retry -> verify; verify -> expired [label="invalid"]; verify -> auth [label="valid"];
  auth -> result [label="authorized"]; auth -> denied [label="access lost"];
}
