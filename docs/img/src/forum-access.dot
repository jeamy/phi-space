// Who may see what when a room is linked to a workspace (docs/forum-seite-plan-2026-11-26.en.md, section 6). The labels
// are in a file per language (forum-access.en.sed, forum-access.de.sed): render as style.inc says, with
// "-f forum-access.en.sed" added to the sed for ../forum-access.svg and "-f forum-access.de.sed" for ../forum-access-de.svg.
digraph "@title@" {
#include
	rankdir=LR;
	owner [label="@owner@", fillcolor="#fcf2d9"];
	subgraph cluster_ws {
		labelloc=b; label="@ws@"; labeljust=l; color="#648a85"; style=rounded;
		src [label="@src@"];
		dst [label="@dst@"];
		other [label="@other@"];
	}
	agent [label="@agent@", fillcolor="#d8eeea"];
	subgraph cluster_room {
		labelloc=b; label="@room@"; labeljust=l; color="#648a85"; style=rounded;
		copy [label="@copy@"];
		members [label="@members@"];
	}
	providers [label="@providers@", fillcolor="#fcf2d9"];
	owner -> src [label="@viewer@"]; owner -> dst [label="@editor@"];
	owner -> agent [label="@revoke@", style=dashed];
	agent -> src [label="@reads@"]; agent -> dst [label="@readswrites@"];
	agent -> copy; copy -> members; copy -> providers [label="@excerpts@"];
}
